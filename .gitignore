__pycache__/
*.pyc
.venv/
.venv_test/
.venv_bridge/
python_path.txt
.env
.vercel
# Restos de cuando la app usaba SQLite local + Tesseract local — ya no se
# usan (ahora es Postgres + Claude Vision), pero pueden seguir existiendo
# en discos de desarrollo viejos. Nunca deberían subirse: la base vieja
# puede tener datos reales, uploads/ tiene escaneos reales de remitos.
deposito.db
.secret_key
uploads/
tessdata/

# Config real del bridge de escaneo local (tiene el token de subida) —
# solo se sube la plantilla .example.
scanner_bridge_config.txt

# Certificado autofirmado del bridge (se genera una vez por PC, distinto en
# cada instalación — no tiene sentido versionarlo, ver scanner_bridge.py).
bridge_cert.pem
bridge_key.pem

# CA local del bridge de escaneo (ver gestionar_certificados.py): ca_key.pem
# es una clave privada, nunca se sube. ca_cert.pem e ips_permitidas.txt son
# específicos de esta instalación (quién administra qué IPs), tampoco.
ca_cert.pem
ca_key.pem
ips_permitidas.txt
