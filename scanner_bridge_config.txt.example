# Copiar este archivo como "scanner_bridge_config.txt" (sin ".example") en la
# misma carpeta, y completar los valores reales.

# URL de la app de Depósito Delmy.
APP_URL=https://deposito-delmy.vercel.app

# Tiene que ser el mismo valor que SCANNER_API_TOKEN configurado en el
# servidor (variable de entorno en Vercel / archivo .env local).
TOKEN=

# Puerto donde escucha este programa en la PC (no hace falta tocarlo salvo
# que ya esté ocupado por otra cosa).
PUERTO=5055
